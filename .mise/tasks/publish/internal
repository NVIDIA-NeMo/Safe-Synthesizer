#MISE description="Build and publish wheel to NVIDIA Artifactory"
#MISE alias="publish-internal"
#MISE depends=["build-wheel"]

set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/tasks/_lib.sh"

require_env TWINE_REPOSITORY_URL "TWINE_REPOSITORY_URL is not set. Set it to the URL of the Artifactory repository."
require_env TWINE_USERNAME "TWINE_USERNAME is not set. Set it to the username for the Artifactory repository."
require_env TWINE_PASSWORD "TWINE_PASSWORD is not set. Set it to the password for the Artifactory repository."

echo "~~~~~~"
echo "uploading to Artifactory: ${TWINE_REPOSITORY_URL}"
uvx twine upload \
  --repository-url "${TWINE_REPOSITORY_URL}" \
  --non-interactive \
  --verbose \
  dist/*.whl
echo "published: $(ls dist/*.whl)"
