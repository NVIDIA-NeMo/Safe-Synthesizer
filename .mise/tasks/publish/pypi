#MISE description="Build and upload dist/*.whl to PyPI. Requires TWINE_USERNAME=__token__ and TWINE_PASSWORD with a PyPI token."
#MISE alias="publish-pypi"
#MISE depends=["publish:check:pypi-env", "build-wheel"]

set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/tasks/_lib.sh"

require_env TWINE_USERNAME "TWINE_USERNAME is not set. For PyPI token auth, set TWINE_USERNAME=__token__."
require_env TWINE_PASSWORD "TWINE_PASSWORD is not set. For PyPI token auth, set TWINE_PASSWORD=<your-pypi-token>."

echo "~~~~~~"
echo "uploading to PyPI"
uvx twine upload \
  --non-interactive \
  --verbose \
  dist/*.whl
echo "published: $(ls dist/*.whl)"
