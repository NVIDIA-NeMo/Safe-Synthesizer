#MISE description="Build CUDA runtime container (CLI wrapper)"
#MISE alias="container-build-gpu"

set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/tasks/_lib.sh"

container_cmd="$(resolve_container_cmd)"

"${container_cmd}" build \
  --platform "${CONTAINER_GPU_PLATFORM:-linux/amd64}" \
  --tag "${CONTAINER_GPU_IMAGE:-nss-gpu:latest}" \
  --target runtime \
  --progress=plain \
  -f "${CONTAINER_GPU_FILE:-containers/Dockerfile.cuda}" \
  .
