#MISE description="Verify mise-managed tools install correctly in a container"
#MISE alias="test-tool-install"
#MISE depends=["container:build:test-setup"]

set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/tasks/_lib.sh"

container_cmd="$(resolve_container_cmd)"

"${container_cmd}" run \
  --rm \
  --platform "${CONTAINER_TEST_PLATFORM:-linux/amd64}" \
  "${CONTAINER_TEST_IMAGE_SETUP:-nss-test-setup:latest}" \
  bash -c '
    echo "=== Verifying installed tools ===" &&
    mise --version &&
    uv --version &&
    ruff --version &&
    ty --version &&
    jq --version &&
    yq --version &&
    gh --version &&
    osv-scanner --version &&
    echo "=== All tools OK ==="'
