#MISE description="Run CI unit tests in a Linux container"
#MISE alias="test-ci-container"
#MISE depends=["container:build:test"]

set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/tasks/_lib.sh"

container_cmd="$(resolve_container_cmd)"
repo_root="$(pwd -P)"

"${container_cmd}" run \
  --rm \
  --platform "${CONTAINER_TEST_PLATFORM:-linux/amd64}" \
  --mount "type=bind,source=${repo_root},target=/workspace" \
  -e DEBIAN_FRONTEND=noninteractive \
  "${CONTAINER_TEST_IMAGE:-nss-test:latest}" \
  mise run test:ci
