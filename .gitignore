# ignores agents.local.md, cursor.local.md, claude.local.md, etc.
*.local.md
.cursor/rules/personal/
.cursor/sandbox.json
.agents/skills/personal/
.agents/skills
.claude/settings.local.json
.cursor/sandbox.json
ai/tmp/
venv*/
env*/
*.env
*.env.local
*.envrc
mise.local.toml
.mise.local.toml
.devmachine.local.toml
temp
__pycache__/*
*.pyc
*.pyo
.DS_Store
.cache
.coverage*
coverage.xml
coverage.json
integration-coverage*
integration-report.xml
.pytest_cache
.eggs
*.egg-info
build
dist
.mypy_cache
# .python-version is tracked -- uv reads it to select the interpreter
.history
.venv
.ruff_cache
report.xml
test_db.sqlite
# File used for populating vulns
dependabot.json

# Visual Studio Code config
.vscode/
*.code-workspace
# PyCharm config
.idea/
.scratch/

# automatically generated folders
site/
docs/_build/
docs/_repo/
docs/pysdk/reference/

# artifacts from running ./scripts/build_docs.sh
docs/_build
docs/conf.py
!docs/**/_snippets/**/*.log
docs/**/_snippets/**/*.tgz

# artifacts from running Jupyter notebooks
.ipynb_checkpoints/

# TLS certs and keys
*.crt
*.key
*.pem
*.enc
*.csr

*-artifacts/

# this is sometimes used by wandb as a local path.
wandb/

# symbolic link to the nmp repo folder for uv dependency resolution.
.nmp_repo
