# The development Python, which house writes and CI reads, is committed even where an earlier rule ignores it.
!/.python-version
# END managed: house
# The build tasks under .mise/tasks/ are tracked although the build/ rules above ignore them.
!.mise/tasks/**/build/
!.mise/tasks/**/build/**
