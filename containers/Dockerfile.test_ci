FROM python:3.11-slim AS setup

ARG PYTHON_VERSION=3.11

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git curl build-essential make gpg dirmngr gpg-agent && \
    rm -rf /var/lib/apt/lists/*

# Keep venv outside /workspace so bind mounts don't shadow it
ENV UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /workspace

# Install mise and all dev tools including uv (cached until .mise.toml or task files change)
COPY .mise.toml .
COPY .mise/tasks/ .mise/tasks/
COPY tasks/ tasks/
COPY mise.lock .
RUN mkdir -p /workspace/tools
COPY tools/install-mise.sh ./tools/install-mise.sh
RUN MISE_VERSION=v2026.5.2 \
    MISE_GPG_KEY=24853EC9F655CE80B48E6C3A8B81C9D17413A06D \
    bash tools/install-mise.sh && \
    MISE_YES=1 mise trust && \
    PYTHON_VERSION="${PYTHON_VERSION}" MISE_YES=1 mise run setup

ENV PATH="/root/.local/share/mise/shims:/root/.local/bin:${PATH}"

FROM setup AS install-deps
# Install Python dependencies (cached until pyproject.toml, uv.lock, or src/ or tests/ change)
COPY pyproject.toml .
COPY ruff.toml .
COPY pytest.ini .
COPY README.md .
COPY uv.lock .
COPY src/ src/
COPY tests/ tests/
RUN mise run bootstrap-nss cpu

RUN git config --global --add safe.directory /workspace
