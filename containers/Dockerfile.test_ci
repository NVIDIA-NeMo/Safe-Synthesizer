FROM python:3.13.13-slim AS setup

ARG PYTHON_VERSION=3.13.13

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git curl build-essential make gpg && \
    rm -rf /var/lib/apt/lists/*

# Keep venv outside /workspace so bind mounts don't shadow it
ENV UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /workspace

# Install mise and all dev tools including uv (cached until .mise.toml or task files change)
COPY .mise.toml .
COPY .mise/tasks/ .mise/tasks/
COPY mise.lock .
RUN mkdir -p /workspace/tools
COPY tools/install-mise.sh ./tools/install-mise.sh
COPY install_nss.sh ./install_nss.sh
ENV PATH="/root/.local/share/mise/shims:/root/.local/bin:${PATH}"
RUN MISE_REQUIRE_SIGNED_INSTALL=1 \
    MISE_GPG_KEY=24853EC9F655CE80B48E6C3A8B81C9D17413A06D \
    bash tools/install-mise.sh && \
    MISE_YES=1 mise trust && \
    PYTHON_VERSION="${PYTHON_VERSION}" MISE_YES=1 mise run setup

FROM setup AS wheel-install

ENV UV_LINK_MODE=copy

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY dist/*.whl /tmp/dist/

RUN --mount=type=cache,target=/root/.cache/uv \
    wheel_count="$(find /tmp/dist -maxdepth 1 -type f -name '*.whl' | wc -l)" && \
    test "${wheel_count}" -eq 1 && \
    wheel="$(find /tmp/dist -maxdepth 1 -type f -name '*.whl')" && \
    CUDA=cpu \
        NSS_INSTALLER_ISOLATED=1 \
        UV_PROJECT_ENVIRONMENT=/opt/wheel-cpu \
        PACKAGE_WHEEL="${wheel}" \
        ./install_nss.sh && \
    uv --no-config pip check --python /opt/wheel-cpu/bin/python && \
    /opt/wheel-cpu/bin/python -c \
        "from importlib.metadata import version; from nemo_safe_synthesizer.package_info import __version__; assert __version__ == version('nemo-safe-synthesizer')" && \
    /opt/wheel-cpu/bin/safe-synthesizer --help >/dev/null && \
    CUDA=129 NSS_INSTALLER_RESOLVE_INDEXES=1 ./install_nss.sh > /tmp/cu129-indexes && \
    uv --no-config venv --clear --python /usr/local/bin/python /opt/wheel-cu129 && \
    mapfile -t cu129_indexes < /tmp/cu129-indexes && \
    cu129_args=() && for index in "${cu129_indexes[@]}"; do cu129_args+=(--index "${index}"); done && \
    uv --no-config pip install \
        --python /opt/wheel-cu129/bin/python \
        --no-sources \
        --dry-run \
        --default-index https://pypi.org/simple \
        "${cu129_args[@]}" \
        --index-strategy unsafe-best-match \
        "nemo-safe-synthesizer[cu129,engine] @ file://${wheel}" && \
    CUDA=130 NSS_INSTALLER_RESOLVE_INDEXES=1 ./install_nss.sh > /tmp/cu130-indexes && \
    uv --no-config venv --clear --python /usr/local/bin/python /opt/wheel-cu130 && \
    mapfile -t cu130_indexes < /tmp/cu130-indexes && \
    cu130_args=() && for index in "${cu130_indexes[@]}"; do cu130_args+=(--index "${index}"); done && \
    uv --no-config pip install \
        --python /opt/wheel-cu130/bin/python \
        --no-sources \
        --dry-run \
        --default-index https://pypi.org/simple \
        "${cu130_args[@]}" \
        --index-strategy unsafe-best-match \
        "nemo-safe-synthesizer[cu130,engine] @ file://${wheel}" && \
    rm -rf /opt/wheel-cpu /opt/wheel-cu129 /opt/wheel-cu130

FROM setup AS install-deps
# Install Python dependencies (cached until pyproject.toml, uv.lock, or src/ or tests/ change)
COPY pyproject.toml .
COPY ruff.toml .
COPY pytest.ini .
COPY README.md .
COPY uv.lock .
COPY src/ src/
COPY tests/ tests/
RUN mise run bootstrap-nss cpu

RUN git config --global --add safe.directory /workspace
