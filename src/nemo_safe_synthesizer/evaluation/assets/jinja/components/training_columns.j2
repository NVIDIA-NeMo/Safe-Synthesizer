<div class="training-columns-heading">
    <div>
        <h1>Training Data <span>{{ ctx.column_distribution_stability.evaluation_fields | length }} columns</span></h1>
        <p>Column statistics and data types from the training dataset.</p>
    </div>
</div>
<div class="table-wrap">
    <table class="columns-table">
        <thead>
            <tr>
                <th>Column Name</th>
                <th>Unique</th>
                <th>Missing</th>
                <th>Avg. Length</th>
                <th>Type</th>
                {% if ctx.with_transform %}
                <th>Entities</th>
                <th>Transformed</th>
                <th>Transform function</th>
                {% endif %}
            </tr>
        </thead>
        <tbody>
            {% for column in ctx.column_distribution_stability.evaluation_fields %}
            <tr {% if loop.index > 10 %}class="additional-column" hidden{% endif %}>
                <td>{{ column.name }}</td>
                <td>{{ "{:,}".format(column.training_field_features.unique_count) }}</td>
                <td>{{ column.training_field_features.missing_count }}</td>
                <td>{{ column.training_field_features.avg_str_length | round(2) }}</td>
                <td><span class="type-tag">{{ column.training_field_features.type | capitalize }}</span></td>
                {% if ctx.with_transform %}
                <td>
                    {% if column.column_statistics and column.column_statistics.detected_entity_counts %}
                    {% for entity, count in column.column_statistics.detected_entity_counts.items() %}
                    <span class="type-tag">{{ entity }} {{ count }}</span>
                    {% endfor %}
                    {% endif %}
                </td>
                <td>{{ column.column_statistics.is_transformed if column.column_statistics else False }}</td>
                <td>
                    {% if column.column_statistics %}
                    {{ column.column_statistics.transform_functions | join(", ") }}
                    {% endif %}
                </td>
                {% endif %}
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% if ctx.column_distribution_stability.evaluation_fields | length > 10 %}
<button class="show-columns" type="button" data-columns-toggle
        data-columns-count="{{ ctx.column_distribution_stability.evaluation_fields | length }}"
        aria-expanded="false">
    <span data-columns-label>Show all {{ ctx.column_distribution_stability.evaluation_fields | length }} columns</span>
    <span class="columns-chevron" aria-hidden="true"></span>
</button>
{% endif %}
