{% set pii = ctx.pii_replacement %}
{% macro count(value) %}{{ "—" if value is none else "{:,}".format(value) }}{% endmacro %}
{# Collapsed by default, like the inference protection cards; the summary replaces their score ring. #}
<article class="metric-card metric-card--expandable pii-replacement" id="pii-replay" data-metric-card>
    <div class="metric-card-summary">
        <button class="metric-card-toggle" type="button" data-metric-toggle
                aria-expanded="false" aria-controls="pii-replay-details"
                aria-label="Toggle details for PII Replacement and Replay"></button>
        <span class="metric-chevron" aria-hidden="true"></span>
        <span class="metric-card-copy">
            <span class="metric-card-title-row"><span class="metric-card-title">PII Replacement and Replay</span></span>
            <span class="metric-card-description">
                {%- if pii.replacement_off -%}
                PII replacement was off. PII found in the training data and how many original values reappear in the synthetic data
                {%- else -%}
                PII found in the training data, how it was replaced, and how many original values reappear in the synthetic data
                {%- endif -%}
            </span>
        </span>
        <span class="metric-card-stat">{{ pii.headline }}</span>
    </div>

    <div class="metric-card-details" id="pii-replay-details" hidden>
        {% if pii.replacement_off %}
        <p class="pii-context">PII replacement was off, so the model was trained on the original values. PII was
           detected in the training data only for this check.</p>
        {% else %}
        <p class="pii-context">Sampler: {{ pii.sampler }}, locale {{ pii.locale }},
           {{ "random seed" if pii.seed is none else "seed " ~ pii.seed }}. The test data is not replaced.</p>
        {% endif %}
        {% if pii.replay_note %}<p class="pii-context">{{ pii.replay_note }}</p>{% endif %}

        {% if pii.groups %}
        <div class="table-wrap">
            <table class="pii-replacement-table">
                <thead>
                    <tr>
                        <th>Column Name</th>
                        <th>Replaced With</th>
                        <th>PII Type</th>
                        <th>Training Total</th>
                        <th>Training Unique</th>
                        <th title="Synthetic rows containing at least one original training value of this type">Synthetic Rows Matched</th>
                        <th>PII Replay</th>
                    </tr>
                </thead>
                {% for group in pii.groups %}
                <tbody class="pii-group">
                    {% for entity in group.entities %}
                    <tr>
                        {% if loop.first %}
                        {# Long column names may break only after underscores. #}
                        <td class="pii-group-cell" rowspan="{{ group.entities | length }}">
                            {%- for part in group.column_name.split("_") %}{{ part }}{% if not loop.last %}_<wbr>{% endif %}{% endfor -%}
                        </td>
                        <td class="pii-group-cell" rowspan="{{ group.entities | length }}">
                            {% if group.replaced_with %}
                            {{ group.replaced_with }}
                            {% if group.pattern %}<code>{{ group.pattern }}</code>
                            <ul class="pattern-symbols">
                                {% for symbol, meaning in group.pattern_symbols %}
                                <li>{% if symbol != group.pattern %}<code>{{ symbol }}</code> {% endif %}{{ meaning }}</li>
                                {% endfor %}
                            </ul>
                            {% endif %}
                            {% if group.depends_on %}<small>Depends on {{ group.depends_on | map(attribute="column_name") | join(", ") }}</small>{% endif %}
                            {% if group.found_by %}<small>Found by {{ group.found_by | join(", ") }}</small>{% endif %}
                            {% else %}
                            <span class="pii-none">Not replaced</span>
                            {% endif %}
                        </td>
                        {% endif %}
                        <td><span class="type-tag">{{ entity.pii_type }}</span></td>
                        <td class="tnum">{{ count(entity.found) }}</td>
                        <td class="tnum">{{ count(entity.unique) }}</td>
                        <td class="tnum">{{ count(entity.synthetic) }}</td>
                        <td class="tnum">
                            {% if entity.replayed is none %}—{% else %}{{ entity.replay_percentage }}%
                            <small>{{ "{:,}".format(entity.replayed) }} of {{ "{:,}".format(entity.unique) }}</small>{% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
                {% endfor %}
            </table>
        </div>
        {% elif not pii.replay_note %}
        <p class="pii-context">No PII was found in the training data.</p>
        {% endif %}

        {% if pii.mappings %}
        <h3>Value Mappings</h3>
        <div class="table-wrap">
            <table class="pii-mapping-table">
                <thead><tr><th>Column Name</th><th>Data Value</th><th>Sampler Values</th></tr></thead>
                <tbody>
                    {% for column, values in pii.mappings.items() %}
                    {% for value, sampler_values in values.items() %}
                    <tr><td>{{ column }}</td><td>{{ value }}</td><td>{{ sampler_values | join(", ") }}</td></tr>
                    {% endfor %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
        {% if pii.kept_columns %}
        <p class="pii-kept"><strong>Kept as is ({{ pii.kept_columns | length }}):</strong> {{ pii.kept_columns | join(", ") }}</p>
        {% endif %}

        <p class="pii-footnote">Matches are against the original training values, before replacement. Synthetic Rows
           Matched counts synthetic rows containing at least one of them. PII Replay counts distinct training values
           that reappear in the synthetic data; lower is better. In free text, a value counts when it appears
           anywhere in a synthetic text.</p>
    </div>
</article>
