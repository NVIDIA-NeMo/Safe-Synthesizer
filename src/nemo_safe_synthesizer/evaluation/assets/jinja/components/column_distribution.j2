<div class="chart-legend" aria-label="Chart legend">
    <span><i class="legend-training"></i>Training Data</span>
    <span><i class="legend-synthetic"></i>Synthetic Data</span>
</div>
<div class="distribution-charts">
{% for figure in ctx.column_distribution_stability.figures %}
    <span id="{{ figure.name1 | urlencode }}"></span>
    {% if figure.name2 %}<span id="{{ figure.name2 | urlencode }}"></span>{% endif %}
    <figure>{{ figure.figure }}</figure>
{% endfor %}
</div>
