{% from "jinja/components/icon.j2" import icon %}
<section class="dataset-statistics component" id="dataset-statistics">
    <div class="component-heading">
        <h2>Dataset Statistics</h2>
    </div>
    <div class="dataset-comparison">
        <div class="dataset-card training">
            <span class="dataset-tag">Training Data</span>
            <dl>
                <div><dt>Rows</dt><dd>{{ "{:,}".format(ctx.dataset_statistics.training_rows) }}</dd></div>
                <div><dt>Columns</dt><dd>{{ ctx.dataset_statistics.training_cols }}</dd></div>
                <div><dt>Missing</dt><dd>{{ ctx.dataset_statistics.training_missing }}%</dd></div>
            </dl>
        </div>
        <span class="dataset-arrow">{{ icon("arrow-right") }}</span>
        <div class="dataset-card synthetic">
            <span class="dataset-tag">Synthetic Data</span>
            <dl>
                <div><dt>Rows</dt><dd>{{ "{:,}".format(ctx.dataset_statistics.synthetic_rows) }}</dd></div>
                <div><dt>Columns</dt><dd>{{ ctx.dataset_statistics.synthetic_cols }}</dd></div>
                <div><dt>Missing</dt><dd>{{ ctx.dataset_statistics.synthetic_missing }}%</dd></div>
            </dl>
        </div>
    </div>
    {% set memorized_lines = ctx.dataset_statistics.memorized_lines or 0 %}
    <div class="memorization-status{% if memorized_lines > 0 %} memorization-status--warning{% endif %}">
        {{ icon("warning" if memorized_lines > 0 else "check-circle") }}
        Training rows duplicated in Synthetic Data: {{ memorized_lines }}
    </div>
</section>
