{% if ctx.autocorrelation_similarity.score.notes %}
<p class="chart-subheading">{{ ctx.autocorrelation_similarity.score.notes }}</p>
{% endif %}
{% if ctx.autocorrelation_similarity.details.skipped %}
<h3 class="chart-subheading">Skipped comparisons</h3>
<ul>
{% for item in ctx.autocorrelation_similarity.details.skipped[:12] %}
    <li>
        {{ item.column }}{% if item.group is not none %}, group {{ item.group }}{% endif %}: {{ item.reason }}
    </li>
{% endfor %}
</ul>
{% endif %}
{% if ctx.autocorrelation_similarity.details.groups_only_in_training %}
<p class="chart-subheading">
    Groups found only in training data: {{ ctx.autocorrelation_similarity.details.groups_only_in_training | length }}.
</p>
{% endif %}
{% if ctx.autocorrelation_similarity.details.groups_only_in_synthetic %}
<p class="chart-subheading">
    Groups found only in synthetic data: {{ ctx.autocorrelation_similarity.details.groups_only_in_synthetic | length }}.
</p>
{% endif %}
{% if ctx.autocorrelation_similarity.figures %}
<p class="chart-subheading">
    Summarizing {{ ctx.autocorrelation_similarity.evaluated_profile_count }} group and column pairs across
    {{ ctx.autocorrelation_similarity.evaluated_group_count }} groups and
    {{ ctx.autocorrelation_similarity.evaluated_column_count }} value columns.
    {% if ctx.autocorrelation_similarity.evaluated_column_count > ctx.autocorrelation_similarity.pair_score_column_count %}
    Pair scores shows the {{ ctx.autocorrelation_similarity.pair_score_column_count }} lowest-scoring columns.
    {% endif %}
</p>
{% if ctx.autocorrelation_similarity.constant_synthetic_profile_count %}
<p class="chart-subheading">
    {% set constant_count = ctx.autocorrelation_similarity.constant_synthetic_profile_count %}
    {% if constant_count == 1 %}
    1 pair has constant synthetic values. It scores 0 in Pair scores but has no synthetic autocorrelation,
    so the other two charts leave it out.
    {% else %}
    {{ constant_count }} pairs have constant synthetic values. They score 0 in Pair scores but have no synthetic
    autocorrelation, so the other two charts leave them out.
    {% endif %}
</p>
{% endif %}
<div class="chart-legend" aria-label="Chart legend">
    <span><i class="legend-training"></i>Training Data</span>
    <span><i class="legend-synthetic"></i>Synthetic Data</span>
</div>
<div class="autocorrelation-charts">
{% for row in ctx.autocorrelation_similarity.figures %}
<figure>
    <div class="autocorrelation-chart-heading">
        <h3 class="chart-subheading">{{ row.title }}</h3>
        {% if row.column_select and ctx.autocorrelation_similarity.summary_columns | length > 1 %}
        <select class="autocorrelation-column-select" data-autocorrelation-column-select
                data-traces-per-column="{{ ctx.autocorrelation_similarity.summary_traces_per_column }}"
                aria-label="Value column">
            {% for column in ctx.autocorrelation_similarity.summary_columns %}
            <option value="{{ loop.index0 }}">{{ column }}</option>
            {% endfor %}
        </select>
        {% endif %}
    </div>
    {{ row.html | safe }}
</figure>
{% endfor %}
</div>
{% endif %}
