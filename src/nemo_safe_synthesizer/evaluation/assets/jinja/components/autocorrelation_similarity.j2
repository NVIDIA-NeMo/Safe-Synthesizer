{% from "jinja/components/time_series_charts.j2" import chart_grid, comparison_notes %}
{% set metric = ctx.autocorrelation_similarity %}
{{ comparison_notes(metric) }}
{% call chart_grid(metric) %}
{% if metric.constant_synthetic_profile_count %}
<p class="chart-subheading">
    {% set constant_count = metric.constant_synthetic_profile_count %}
    {% if constant_count == 1 %}
    1 pair has constant synthetic values. It scores 0 in Pair scores but has no synthetic autocorrelation,
    so the other two charts leave it out.
    {% else %}
    {{ constant_count }} pairs have constant synthetic values. They score 0 in Pair scores but have no synthetic
    autocorrelation, so the other two charts leave them out.
    {% endif %}
</p>
{% endif %}
{% endcall %}
