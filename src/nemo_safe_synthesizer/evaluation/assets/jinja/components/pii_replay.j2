{% from "jinja/components/icon.j2" import icon %}
<section class="metric-panel pii-panel" id="pii-replay">
    <header class="metric-panel-heading">
        <span class="panel-icon">{{ icon("warning") }}</span>
        <div>
            <h2>PII Replay Analysis</h2>
            <p>Identifies personally identifiable information replayed from training to synthetic data.</p>
        </div>
    </header>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Column Name</th>
                    <th>PII Type</th>
                    <th>Training Total</th>
                    <th>Training Unique</th>
                    <th>Synthetic Total</th>
                    <th>PII Replay</th>
                </tr>
            </thead>
            <tbody>
                {% for field in ctx.pii_replay.pii_replay_data %}
                <tr>
                    <td>{{ field.column_name }}</td>
                    <td><span class="type-tag">{{ field.pii_type }}</span></td>
                    <td class="tnum">{{ field.total_training_data }}</td>
                    <td class="tnum">{{ field.unique_training_data }}</td>
                    <td class="tnum">{{ field.total_synthetic_data }}</td>
                    <td class="tnum">{{ field.unique_synthetic_data }}/{{ field.unique_training_data }}
                        ({{ field.unique_synthetic_data_percentage }}%)</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <footer class="panel-footer">{{ icon("info") }}
        <span>Lower replay percentages indicate better privacy protection for unique PII values</span>
    </footer>
</section>
