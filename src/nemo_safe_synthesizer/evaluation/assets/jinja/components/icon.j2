{% macro icon(name, class_name="") -%}
<svg class="icon{% if class_name %} {{ class_name }}{% endif %}" viewBox="0 0 16 16"
     fill="none" aria-hidden="true">
    {% if name == "calendar" %}
    <path fill="currentColor" d="M5 3V2h1v1h4V2h1v1h3v11H2V3zm0 1H3v2h10V4h-2v1h-1V4H6v1H5zm8 3H3v6h10z"></path>
    {% elif name == "document" or name == "text" %}
    <path fill="currentColor" d="M13 5.293V14H3V2h6.707zM12 13V6H9V3H4v10zm-.707-8L10 3.707V5z"></path>
    {% elif name == "quality" %}
    <g fill="currentColor">
        <path d="m4.146 7.854.708-.708L7 9.293l4.147-4.147.707.708L7 10.707z"></path>
        <path d="m11.871 1.295.509 2.325 2.325.509-.722 2.268L15.743 8l-1.76 1.603.722 2.268-2.325.509-.509 2.325-2.268-.722L8 15.743l-1.603-1.76-2.268.722-.509-2.325-2.325-.509.722-2.268L.257 8l1.76-1.603-.722-2.268L3.62 3.62l.509-2.325 2.268.722L8 .257l1.603 1.76zm-7 1.286-.41 1.88-1.88.41.583 1.833L1.742 8l1.422 1.297-.583 1.833 1.88.41.41 1.88 1.833-.583L8 14.259l1.297-1.424 1.833.584.41-1.88 1.88-.41-.583-1.833L14.259 8l-1.424-1.296.584-1.833-1.88-.41-.41-1.88-1.833.583L8 1.742 6.704 3.164z"></path>
    </g>
    {% elif name == "lock" %}
    <path fill="currentColor" d="M5 5a3 3 0 0 1 6 0v2h1v7H4V7h1zm0 3v5h6V8zm5-3a2 2 0 1 0-4 0v2h4z"></path>
    {% elif name == "columns" %}
    <path fill="currentColor" d="M3 2h10v12H3zm1 1v10h2V3zm3 0v10h2V3zm3 0v10h2V3z"></path>
    {% elif name == "chart" %}
    <path fill="currentColor" d="M8 5H7V3.707L3.354 7.354l-.708-.708L6.293 3H5V2h3zm5 9H3v-4h3V8h3V6h4zm-1-7h-2v6h2zm-5 6h2V9H7zm-3-2v2h2v-2z"></path>
    {% elif name == "shield" %}
    <path fill="currentColor" d="m8 2.009 5.978 1.601.021.36-.5.03.5-.03v.01l.002.02.003.078q.005.102.006.286c.002.245-.002.594-.027 1.016a16 16 0 0 1-.5 3.188c-.645 2.384-2.102 5.102-5.362 5.917l-.121.03-.121-.03c-3.26-.815-4.717-3.533-5.362-5.917a16 16 0 0 1-.5-3.188q-.04-.69-.019-1.38L2 3.98v-.008L2.5 4 2 3.97l.022-.36zM2.99 4.386c-.002.226.002.547.025.937.045.798.167 1.87.468 2.984.596 2.208 1.86 4.455 4.517 5.176 2.657-.72 3.92-2.968 4.517-5.176.301-1.113.423-2.186.468-2.984.022-.39.026-.711.025-.937L8 3.044z"></path>
    {% elif name == "warning" %}
    <path fill="currentColor" d="m8 .984 7.357 13.014H.643zM2.357 12.998h11.286L8 3.016zM7.5 10V6.5h1V10zm0 2v-1h1v1z"></path>
    {% elif name == "info" %}
    <path fill="currentColor" d="M8 2a6 6 0 1 0 0 12A6 6 0 0 0 8 2M1 8a7 7 0 1 1 14 0A7 7 0 0 1 1 8m7.5-4v1h-1V4zm0 2v6h-1V6z"></path>
    {% elif name == "info-filled" %}
    <path fill="currentColor" d="M1 8c0-3.86599 3.13401-7 7-7s7 3.13401 7 7-3.13401 7-7 7-7-3.13401-7-7m7.5-3V4h-1v1zm0 7V6h-1v6z"></path>
    {% elif name == "arrow-right" %}
    <path fill="currentColor" d="M10.793 8.5H3v-1h7.793L7.646 4.354l.708-.708L12.707 8l-4.353 4.354-.708-.707z"></path>
    {% elif name == "check-circle" %}
    <path fill="currentColor" d="M1 8c0-3.86599 3.13401-7 7-7s7 3.13401 7 7-3.13401 7-7 7-7-3.13401-7-7M7 10.707l4.854-4.853-.707-.708L7 9.293 4.854 7.146l-.708.708z"></path>
    {% elif name == "close" %}
    <path fill="currentColor" d="m7.293 8-4.647-4.646.708-.708L8 7.293l4.647-4.647.707.708L8.707 8l4.647 4.647-.707.707L8 8.707l-4.646 4.647-.708-.707z"></path>
    {% endif %}
</svg>
{%- endmacro %}
