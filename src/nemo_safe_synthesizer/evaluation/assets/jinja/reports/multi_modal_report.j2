<!DOCTYPE html>
<html lang="en">
{% from "jinja/components/score_gauge.j2" import score_ring %}
{% from "jinja/components/metric_card.j2" import metric_card %}
{% from "jinja/components/icon.j2" import icon %}

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Safe Synthesizer Quality &amp; Privacy Report</title>
    <style>{% include "css/multi_modal_report.css" %}</style>
    <script src="https://cdn.plot.ly/plotly-3.3.1.min.js"></script>
</head>

<body>
    <header class="report-header">
        <div class="report-title">Safe Synthesizer Quality &amp; Privacy Report</div>
        <div class="report-date" aria-label="Report generated date">
            {{ icon("calendar") }}{{ now.strftime("%m/%d/%y") }}
        </div>
    </header>

    <aside class="report-sidebar" aria-label="Report sections">
        <nav class="report-nav">
            <a href="#overview" data-report-nav="overview" class="active">
                <span class="nav-icon">{{ icon("document") }}</span>Overview
            </a>
            {% if ctx.with_synthesizer %}
            <a href="#synthetic-quality" data-report-nav="synthetic-quality">
                <span class="nav-icon">{{ icon("quality") }}</span>Synthetic Quality
            </a>
            {% endif %}
            {% if (ctx.with_data_privacy) or (ctx.pii_replay and ctx.pii_replay.pii_replay_data) %}
            <a href="#data-privacy" data-report-nav="data-privacy">
                <span class="nav-icon">{{ icon("lock") }}</span>Data Privacy
            </a>
            {% endif %}
            {% if ctx.get('column_distribution_stability', {}).get('evaluation_fields') %}
            <a href="#training-columns" data-report-nav="training-columns">
                <span class="nav-icon">{{ icon("columns") }}</span>Training Data
            </a>
            {% endif %}
        </nav>
    </aside>

    <main class="report-main">
        <section class="report-view active" id="overview" data-report-view="overview">
            <h1>Report Overview</h1>
            <p class="view-intro">
                The evaluation report provides scores from 0.0 to 10.0 to measure the quality and privacy of the
                synthetic data compared to the training data. The scores are meant to provide a baseline understanding
                of &quot;Did it work?&quot; You are encouraged to perform your own evaluation on your downstream use case.
            </p>
            {% if ctx.job_id %}<div class="job-id"><span>Job ID</span>{{ ctx.job_id }}</div>{% endif %}
            {% if ctx.with_synthesizer %}{% include "jinja/components/score_overview.j2" %}{% endif %}
            {% include "jinja/components/dataset_statistics.j2" %}
        </section>

        {% if ctx.with_synthesizer %}
        <section class="report-view" id="synthetic-quality" data-report-view="synthetic-quality">
            <h1>Synthetic Quality</h1>

            <div class="score-hero component component--gradient">
                <div class="score-hero-visual">
                    {{ score_ring(ctx.synthetic_quality_score.score) }}
                    <span class="score-label">{{ ctx.synthetic_quality_score.score.grade }}</span>
                </div>
                <div class="score-hero-copy">
                    <h2>Synthetic Quality Score (SQS)</h2>
                    <p>
                        The <a href="https://nvidia-nemo.github.io/Safe-Synthesizer/product-overview/evaluation/#synthetic-quality-score-sqs"
                        target="_blank" rel="noopener noreferrer">SQS measures</a> how well synthetic data preserves
                        the statistical properties of your training data, scoring 0.0–10.0 (higher is better) across up
                        to 5 subscores.
                    </p>
                </div>
            </div>

            <aside class="guidance-notification" data-dismissible>
                <span class="notification-icon">{{ icon("info-filled") }}</span>
                <div class="notification-copy">
                    <h3>Understanding Quality Scores</h3>
                    <p>Some quality loss is expected — and acceptable — since it's inherent to privacy preservation.
                       Mid-range scores are often sufficient for model training. You should test your synthetic data on
                       the downstream use case to assess true viability.</p>
                    <p>Low scores suggest you should
                       <a href="https://nvidia-nemo.github.io/Safe-Synthesizer/user-guide/evaluating-data/#low-sqs-scores"
                       target="_blank" rel="noopener noreferrer">adjust your configuration</a> to improve model learning.</p>
                </div>
                <button type="button" data-dismiss aria-label="Dismiss quality score guidance">{{ icon("close") }}</button>
            </aside>

            <section class="metric-panel">
                <header class="metric-panel-heading">
                    <span class="panel-icon">{{ icon("chart") }}</span>
                    <div><h2>Numerical and Categorical Metrics</h2>
                    <p>Measures preservation of statistical relationships across all numerical and categorical columns.</p></div>
                </header>
                <div class="metric-list">
                    {% call metric_card("correlation-stability", ctx.column_correlation_stability.name,
                            ctx.column_correlation_stability.score,
                            "Measures how well correlations between columns are preserved",
                            ctx.tooltips.column_correlation_stability_info,
                            expandable=ctx.column_correlation_stability.figure) %}
                        {% include "jinja/components/correlation.j2" %}
                    {% endcall %}
                    {% call metric_card("structure-stability", ctx.deep_structure_stability.name,
                            ctx.deep_structure_stability.score,
                            "Measures how well structural relationships are maintained",
                            ctx.tooltips.deep_structure_stability_info,
                            expandable=ctx.deep_structure_stability.figure) %}
                        {% include "jinja/components/deep_structure.j2" %}
                    {% endcall %}
                    {% call metric_card("distribution-stability", ctx.column_distribution_stability.name,
                            ctx.column_distribution_stability.score,
                            "Measures how well value distributions are preserved",
                            ctx.tooltips.column_distribution_stability_info,
                            expandable=ctx.column_distribution_stability.figures) %}
                        {% include "jinja/components/column_distribution.j2" %}
                    {% endcall %}
                </div>
            </section>

            <section class="metric-panel">
                <header class="metric-panel-heading">
                    <span class="panel-icon">{{ icon("text") }}</span>
                    <div><h2>Text Metrics</h2>
                    <p>Measures pattern and meaning preservation across text columns.</p></div>
                </header>
                <div class="metric-list">
                    {% call metric_card("semantic-similarity", ctx.text_semantic_similarity.name,
                            ctx.text_semantic_similarity.score,
                            "Measures meaning preservation in text fields",
                            ctx.tooltips.text_semantic_similarity_info,
                            expandable=ctx.text_semantic_similarity.figures) %}
                        {% include "jinja/components/text_semantic_similarity.j2" %}
                    {% endcall %}
                    {% call metric_card("structure-similarity", ctx.text_structure_similarity.name,
                            ctx.text_structure_similarity.score,
                            "Measures structural pattern preservation in text fields",
                            ctx.tooltips.text_structure_similarity_info,
                            expandable=ctx.text_structure_similarity.figures) %}
                        {% include "jinja/components/text_structure_similarity.j2" %}
                    {% endcall %}
                </div>
            </section>
        </section>
        {% endif %}

        {% if (ctx.with_data_privacy) or (ctx.pii_replay and ctx.pii_replay.pii_replay_data) %}
        <section class="report-view" id="data-privacy" data-report-view="data-privacy">
            <h1>Data Privacy</h1>

            {% if ctx.with_data_privacy %}
            <div class="score-hero component component--gradient">
                <div class="score-hero-visual">
                    {{ score_ring(ctx.data_privacy_score.score) }}
                    <span class="score-label">{{ ctx.data_privacy_score.score.grade }}</span>
                </div>
                <div class="score-hero-copy">
                    <h2>Data Privacy Score (DPS)</h2>
                    <p>The <a href="https://nvidia-nemo.github.io/Safe-Synthesizer/product-overview/evaluation/#data-privacy-score-dps"
                       target="_blank" rel="noopener noreferrer">DPS</a> measures how well synthetic data protects
                       sensitive information from the training data, scoring 0.0–10.0 (higher is better).</p>
                    <hr>
                    <div class="dp-status">
                        <span>Differential Privacy</span>
                        <strong class="dp-tag">{{ "Enabled" if ctx.dp_enabled else "Disabled" }}</strong>
                        {% if ctx.dp_enabled %}<small>epsilon {{ ctx.epsilon }} · delta {{ ctx.delta }}</small>{% endif %}
                    </div>
                    <p class="dp-description"><a href="https://nvidia-nemo.github.io/Safe-Synthesizer/product-overview/data_synthesis/#differential-privacy"
                       target="_blank" rel="noopener noreferrer">Differential Privacy</a> offers supplemental
                       protection for mathematical privacy guarantees beyond the inherent privacy of synthetic data.
                       It typically comes with a reduction in quality and longer training time.</p>
                </div>
            </div>

            <aside class="guidance-notification" data-dismissible>
                <span class="notification-icon">{{ icon("info-filled") }}</span>
                <div class="notification-copy"><h3>Understanding Privacy Scores</h3>
                <p>High DPS scores mean adversaries rarely outperform random chance across hundreds of simulated attacks.
                   Scores are penalized for even minor information leakage; mid-range scores still imply significant
                   uncertainty for attackers.</p>
                <p>Low scores suggest you should
                   <a href="https://nvidia-nemo.github.io/Safe-Synthesizer/product-overview/evaluation/#dps-interpretation"
                   target="_blank" rel="noopener noreferrer">adjust your configuration</a> to improve privacy protection.</p></div>
                <button type="button" data-dismiss aria-label="Dismiss privacy score guidance">{{ icon("close") }}</button>
            </aside>

            <section class="metric-panel">
                <header class="metric-panel-heading">
                    <span class="panel-icon">{{ icon("shield") }}</span>
                    <div><h2>Protection Metrics</h2>
                    <p>Measures resistance to inference attacks on the synthetic data.</p></div>
                </header>
                <div class="metric-list">
                    {% call metric_card("mia", ctx.membership_inference_protection.name,
                            ctx.membership_inference_protection.score,
                            "Protection against attacks that determine whether a record was in training data",
                            ctx.tooltips.membership_inference_info,
                            expandable=ctx.membership_inference_protection.figure) %}
                        {% include "jinja/components/membership_inference_protection.j2" %}
                    {% endcall %}
                    {% call metric_card("aia", ctx.attribute_inference_protection.name,
                            ctx.attribute_inference_protection.score,
                            "Protection against attacks that infer sensitive attributes",
                            ctx.tooltips.attribute_inference_info,
                            expandable=ctx.attribute_inference_protection.figure) %}
                        {% include "jinja/components/attribute_inference_protection.j2" %}
                    {% endcall %}
                </div>
            </section>
            {% endif %}

            {% if ctx.pii_replay and ctx.pii_replay.pii_replay_data %}
                {% include "jinja/components/pii_replay.j2" %}
            {% endif %}
        </section>
        {% endif %}

        {% if ctx.get('column_distribution_stability', {}).get('evaluation_fields') %}
        <section class="report-view" id="training-columns" data-report-view="training-columns">
            {% include "jinja/components/training_columns.j2" %}
        </section>
        {% endif %}
    </main>

    <script>{% include "js/multi_modal_toggle.js" %}</script>
</body>
</html>
